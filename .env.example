# Copy to .env for local use. .env is gitignored — never commit real values.
#
# MANUAL STEP on a new machine: this file is not restored by `npm install`;
# recreate `.env` yourself and fill in one of the two auth options below.

# Option A — pay-per-token, from https://platform.claude.com/
ANTHROPIC_API_KEY=

# Option B — uses an existing Claude Pro/Max/Team/Enterprise subscription
# instead of pay-per-token billing. Generate by running `claude setup-token`
# in a real interactive terminal (opens a browser login, then prints the
# token) — it hangs with no output in a non-interactive shell. Leave
# ANTHROPIC_API_KEY empty above if you use this.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional — overrides the model used by every pipeline stage.
# Default when unset: claude-sonnet-5 (see src/config.ts).
CLAUDE_MODEL=
